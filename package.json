{
  "name": "aquacell-erp",
  "version": "1.0.0",
  "description": "AQUA CELL ERP Mobile Phones & Electronics Trading Desktop Software",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3006",
    "build": "next build",
    "start": "next start -p 3006",
    "desktop": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.aquacell.erp",
    "productName": "AQUA CELL ERP",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AQUA CELL ERP"
    }
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.475.0",
    "next": "15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8",
    "tailwindcss": "^4",
    "typescript": "^5.4.5"
  }
}
